VAULT_HOST=vault.example.com
VAULT_PUBLIC_URL=https://vault.example.com

VAULT_OIDC_ISSUER=https://id.example.com
VAULT_OIDC_AUDIENCE=REPLACE_ME
VAULT_OIDC_READ_GROUP=vault
VAULT_OIDC_WRITE_GROUP=vault-writers

S3_ENDPOINT=https://s3.example.com
S3_BUCKET=vault
S3_ACCESS_KEY=REPLACE_ME
S3_SECRET_KEY=REPLACE_ME
S3_PREFIX=
S3_REGION=us-east-1

# A local vault instead of S3: drop the S3_* lines, set VAULT_PATH=/vault and bind-mount the folder there.
